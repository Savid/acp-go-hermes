{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized rate-limits request params",
  "type": "object",
  "properties": {
    "providerId": {
      "$ref": "#/$defs/nonblankString"
    },
    "sessionId": {
      "$ref": "#/$defs/nonblankString"
    }
  },
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "nonblankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "description": "Contains a character outside the Unicode White_Space set. Preserve the complete opaque spelling."
    }
  }
}
