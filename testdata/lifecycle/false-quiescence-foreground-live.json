{
  "name": "false-quiescence-foreground-live",
  "purpose": "A positive quiescence fact asserts that nothing rooted at or before its watermark is live, and the foreground alone can disprove it. One delivered while the foreground is running is refused even though the stream holds no activity and no action: a reducer that reads only entity liveness would certify a boundary over work the foreground itself reports.",
  "negotiated": {
    "version": 1,
    "updatesOutsidePrompt": true,
    "authoritativeQuiescence": true,
    "quiescenceSource": "process-containment",
    "activityKinds": ["task", "subagent"]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "idle", "cycleId": "cyc-0"},
              "activities": [],
              "actions": [],
              "quiescence": {"quiescent": false}
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 2,
            "event": {
              "type": "prompt_accepted",
              "submissionId": "sub-1",
              "clientNonce": "non-1",
              "turnId": "turn-1"
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 3,
            "event": {
              "type": "state_update",
              "state": "running",
              "cycleId": "cyc-1",
              "turnId": "turn-1",
              "cause": "submission"
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 4,
            "event": {
              "type": "quiescence_update",
              "quiescent": true,
              "source": "process-containment",
              "watermark": 3
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "false_quiescence",
    "atInput": 3,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 3,
      "suppressedRetransmissions": 0,
      "foreground": {"state": "running", "cycleId": "cyc-1", "turnId": "turn-1"},
      "turns": [{"turnId": "turn-1", "origin": "submission", "terminal": false}],
      "activities": [],
      "actions": [],
      "quiescence": {"certified": false},
      "closed": false
    }
  }
}
