            "version": 1,
            "streamId": "strm-1",
            "sequence": 9,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "running", "cycleId": "cyc-2", "turnId": "turn-5", "origin": "submission"},
              "activities": [{"activityId": "act-1", "kind": "task", "state": "running", "cause": "submission", "originTurnId": "turn-5"}],
              "actions": [],
              "quiescence": {"quiescent": true, "source": "process-containment", "watermark": 8}
            }
          }
        }
      }
    }
  ],
  "postRefusal": [
