{
  "name": "false-quiescence-holds-activity",
  "purpose": "A positive quiescence fact is disproved by a single nonterminal activity, with nothing else live. The foreground has returned to idle and settled its turn, so a reducer that reads only foreground state would certify a boundary over background work the stream still holds: foreground completion proves nothing about owned activity.",
  "negotiated": {
    "version": 1,
    "updatesOutsidePrompt": true,
    "authoritativeQuiescence": true,
    "quiescenceSource": "process-containment",
    "activityKinds": ["task", "subagent"]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "idle", "cycleId": "cyc-0"},
              "activities": [],
              "actions": [],
              "quiescence": {"quiescent": false}
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 2,
            "event": {
              "type": "prompt_accepted",
              "submissionId": "sub-1",
              "clientNonce": "non-1",
              "turnId": "turn-1"
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 3,
            "event": {
              "type": "state_update",
              "state": "running",
              "cycleId": "cyc-1",
              "turnId": "turn-1",
              "cause": "submission"
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 4,
            "event": {
              "type": "activity_update",
              "activity": {
                "activityId": "act-1",
                "kind": "task",
                "state": "running",
                "cause": "submission",
                "originTurnId": "turn-1"
              }
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 5,
            "event": {
              "type": "state_update",
              "state": "idle",
              "cycleId": "cyc-1",
              "turnId": "turn-1",
              "cause": "submission",
              "stopReason": "end_turn",
              "outcome": "success"
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 6,
            "event": {
              "type": "quiescence_update",
              "quiescent": true,
              "source": "process-containment",
              "watermark": 5
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "false_quiescence",
    "atInput": 5,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 5,
      "suppressedRetransmissions": 0,
      "foreground": {"state": "idle", "cycleId": "cyc-1"},
      "turns": [{"turnId": "turn-1", "origin": "submission", "terminal": true, "outcome": "success"}],
      "activities": [{"activityId": "act-1", "kind": "task", "state": "running", "originTurnId": "turn-1"}],
      "actions": [],
      "quiescence": {"certified": false},
      "closed": false
    }
  }
}
