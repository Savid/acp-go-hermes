            "streamId": "strm-1",
            "sequence": 4,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "requires_action", "cycleId": "cyc-1", "turnId": "turn-1", "origin": "submission"},
              "activities": [],
