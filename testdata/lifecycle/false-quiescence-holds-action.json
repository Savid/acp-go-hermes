{
  "name": "false-quiescence-holds-action",
  "purpose": "A positive quiescence fact is disproved by a single unresolved action, with nothing else live. The foreground is idle and the stream holds no activity, so a reducer that reads foreground state and activity liveness alone would certify a boundary while a pending action still keeps its owner incomplete.",
  "negotiated": {
    "version": 1,
    "updatesOutsidePrompt": true,
    "authoritativeQuiescence": true,
    "quiescenceSource": "process-containment",
    "activityKinds": ["task", "subagent"]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "idle", "cycleId": "cyc-0"},
              "activities": [],
              "actions": [],
              "quiescence": {"quiescent": false}
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 2,
            "event": {
              "type": "prompt_accepted",
              "submissionId": "sub-1",
              "clientNonce": "non-1",
              "turnId": "turn-1"
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 3,
            "event": {
              "type": "action_update",
              "action": {
                "actionId": "act-perm-1",
                "kind": "permission",
                "state": "pending",
                "owner": {"type": "turn", "id": "turn-1"},
                "blocksForeground": false
              }
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 4,
            "event": {
              "type": "quiescence_update",
              "quiescent": true,
              "source": "process-containment",
              "watermark": 3
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "false_quiescence",
    "atInput": 3,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 3,
      "suppressedRetransmissions": 0,
      "foreground": {"state": "idle", "cycleId": "cyc-0"},
      "turns": [{"turnId": "turn-1", "origin": "submission", "terminal": false}],
      "activities": [],
      "actions": [
        {
          "actionId": "act-perm-1",
          "kind": "permission",
          "state": "pending",
          "owner": {"type": "turn", "id": "turn-1"},
          "blocksForeground": false
        }
      ],
      "quiescence": {"certified": false},
      "closed": false
    }
  }
}
