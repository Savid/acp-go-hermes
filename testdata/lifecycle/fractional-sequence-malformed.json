            "event": {
              "type": "prompt_accepted",
              "submissionId": "sub-1",
              "clientNonce": "non-1",
              "turnId": "turn-1"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "malformed_envelope",
    "atInput": 1,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 1,
