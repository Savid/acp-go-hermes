{
  "name": "snapshot-first-violation",
  "purpose": "A stream whose first delivered event is a delta rather than lifecycle_snapshot has no truthful starting state, so it is refused before anything is reduced.",
  "negotiated": {
    "versions": [1],
    "updatesOutsidePrompt": true,
    "authoritativeQuiescence": true,
    "quiescenceSource": "process-containment",
    "activityKinds": ["task", "subagent"]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "state_update",
              "state": "running",
              "cycleId": "cyc-1",
              "turnId": "turn-1",
              "cause": "session"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "delta_before_snapshot",
    "atInput": 0,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 0,
      "suppressedRetransmissions": 0,
      "foreground": null,
      "turns": [],
      "activities": [],
      "actions": [],
      "quiescence": {"certified": false},
      "closed": false
    }
  }
}
