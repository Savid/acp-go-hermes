{
  "name": "watermark-claims-own-delivery",
  "purpose": "A watermark fences the sequences at or before it, so it can never reach the event that carries it: a proof covers work that preceded it and never its own delivery. A watermark at or above its own sequence is malformed rather than a proof that happens to cover one event too many.",
  "negotiated": {
    "version": 1,
    "updatesOutsidePrompt": true,
    "authoritativeQuiescence": true,
    "quiescenceSource": "process-containment",
    "activityKinds": ["task", "subagent"]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "idle", "cycleId": "cyc-0"},
              "activities": [],
              "actions": [],
              "quiescence": {"quiescent": false}
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 2,
            "event": {
              "type": "quiescence_update",
              "quiescent": true,
              "source": "process-containment",
              "watermark": 2
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "malformed_envelope",
    "atInput": 1,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 1,
      "suppressedRetransmissions": 0,
      "foreground": {"state": "idle", "cycleId": "cyc-0"},
      "turns": [],
      "activities": [],
      "actions": [],
      "quiescence": {"certified": false},
      "closed": false
    }
  }
}
