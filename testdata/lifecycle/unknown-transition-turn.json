    "violation": "unknown_entity",
    "atInput": 1,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 1,
      "suppressedRetransmissions": 0,
      "foreground": {"state": "idle", "cycleId": "cyc-0"},
      "turns": [],
      "activities": [],
      "actions": [],
      "quiescence": {"certified": true, "source": "process-containment", "watermark": 0},
      "closed": false
    }
  }
