    "version": 1,
    "updatesOutsidePrompt": true,
    "authoritativeQuiescence": true,
    "quiescenceSource": "process-containment",
    "activityKinds": ["task", "subagent"]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {"sessionUpdate": "session_info_update"},
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {"state": "idle", "cycleId": "cyc-0"},
              "activities": [],
              "actions": [],
              "quiescence": {"quiescent": true, "source": "process-containment", "watermark": 0}
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "tool-1",
          "status": "in_progress"
        },
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 2,
            "event": {
              "type": "activity_update",
              "activity": {
                "activityId": "act-1",
                "kind": "task",
                "state": "running",
                "toolCallId": "tool-1",
                "cause": "session",
                "originTurnId": "turn-1"
              }
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "illegal_carrier",
    "atInput": 1,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 1,
      "suppressedRetransmissions": 0,
      "foreground": {"state": "idle", "cycleId": "cyc-0"},
      "turns": [],
      "activities": [],
      "actions": [],
      "quiescence": {"certified": true, "source": "process-containment", "watermark": 0},
      "closed": false
    }
  }
}
